# Copia este archivo como .env.local y llena los valores. .env.local NO se sube al repo (ningún valor real aquí).
# En Vercel, las mismas variables van en Settings → Environment Variables (Production y Preview).

# ---------- Productos y tasa (Saint; las URL traen su clave: van SOLO en .env.local y Vercel) ----------

# Productos REALES de Saint (lib/saint.ts). Se le suma &categoria=CODIGO[,CODIGO…] (mapa en lib/categoriasSaint.ts).
# Vacía: las categorías muestran "No pudimos cargar los productos" (nunca productos inventados).
PRODUCTOS_API_URL=

# Tasa BCV (lib/tasa.ts): responde { "tasa": 886.23 } (la "fecha" es opcional). Si falta o falla, se usa la tasa que
# trae PRODUCTOS_API_URL; sin ninguna, la píldora "Tasa BCV" del header muestra un guion.
TASA_API_URL=

# ---------- Tienda ----------

# WhatsApp de la tienda, formato internacional sin "+" ni espacios (ej. 58412XXXXXXX): pedidos, contacto y privacidad.
NEXT_PUBLIC_WHATSAPP=

# Rotación diaria de los banners del inicio (lib/rotacionBanners.ts). true: cambian cada día a la medianoche de
# Caracas. Vacía o false: siempre el reparto del día 0. Fuera de producción, ?bannerDay=0..4 fuerza un día igual.
ROTACION_ACTIVA=

# ---------- Cuentas de cliente (Better Auth + Neon; lib/auth.ts y lib/db/) ----------

# Base de datos de cuentas, pedidos y eventos en Neon (Postgres). NO es el SQL Server de la tienda.
# En Neon: Dashboard → Connect → elige la rama (en tu computadora, SIEMPRE la rama "dev").
# Con "Connection pooling" ACTIVADO (el host dice -pooler): la usa el sitio.
DATABASE_URL=
# La misma rama con "Connection pooling" DESACTIVADO: solo para `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# OBLIGATORIA. Firma las sesiones y los enlaces de los correos. Una distinta en cada lugar (tu computadora, Vercel).
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Dirección del sitio sin "/" al final. En tu computadora: http://localhost:3000. En Vercel es opcional (respaldo).
BETTER_AUTH_URL=

# Entrar con Google: ID y secreto del cliente OAuth (Google Cloud → Credenciales → ID de cliente de OAuth 2.0).
# URI de redirección autorizada: <dirección del sitio>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- Correos de la cuenta (Resend; lib/correo.ts) ----------

# Clave de Resend con permiso de envío. Sin ella, en tu computadora los correos salen en la consola; en producción el
# registro con contraseña se apaga solo (queda Google).
RESEND_API_KEY=
# Opcional. Remitente de un dominio verificado en Resend; por defecto Centro Ferretero El Pico <no-responder@centroferreteroelpico.com>.
CORREO_REMITENTE=

# ---------- Las pone Vercel solo (no las cargues) ----------
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL y NODE_ENV: el código las lee para
# saber en qué despliegue está (direcciones permitidas de las cuentas, logo de los correos, producción o prueba).
