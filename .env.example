# Copia este archivo como .env.local y llena los valores. .env.local NO se sube al repo.

# URL de la API del catálogo detrás del túnel de Cloudflare.
# Déjala vacía para trabajar con los datos de prueba de lib/mock/.
CATALOGO_API_URL=

# Token secreto para que solo la página pueda consultar la API.
CATALOGO_API_TOKEN=

# Productos REALES de Saint (lib/saint.ts). La URL ya trae la clave (?clave=...): va SOLO en .env.local y Vercel.
# Se le suma &categoria=CODIGO; qué categoría de la web usa qué código está en lib/categoriasSaint.ts.
# Vacía: las categorías del mapa muestran "No pudimos cargar los productos" (nunca los de ejemplo).
PRODUCTOS_API_URL=

# URL del endpoint que devuelve la tasa BCV desde la base de datos, con la forma
# { "tasa": 245.8, "fecha": "2026-10-12T13:00:00-04:00" }. Usa el mismo CATALOGO_API_TOKEN.
# Si falta o falla, se usa la tasa que trae PRODUCTOS_API_URL; sin ninguna, el header muestra un guion.
TASA_BCV_API_URL=
# También sirve TASA_API_URL (mismo uso; si están las dos, gana TASA_BCV_API_URL). La "fecha" es opcional:
# un endpoint que responde solo { "tasa": 886.23 } funciona. Si la URL lleva una clave, va SOLO en .env.local y Vercel.
TASA_API_URL=

# Número de WhatsApp de la tienda, formato internacional sin "+" ni espacios (ej. 58212XXXXXXX).
NEXT_PUBLIC_WHATSAPP=

# ---------- Cuentas de cliente (Better Auth + Neon; lib/auth.ts) ----------

# Base de datos de cuentas en Neon (Postgres). NO es el SQL Server de la tienda.
# En Neon: Dashboard → Connect → elige la rama (en tu computadora, la rama "dev").
#   - Con "Connection pooling" ACTIVADO (el host dice -pooler): DATABASE_URL (la usa el sitio).
#   - Con "Connection pooling" DESACTIVADO: DATABASE_URL_UNPOOLED (solo para `npm run db:migrate`).
# En Vercel ya las pone la integración de Neon (Production y Preview).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Firma las sesiones y los enlaces de los correos. Una distinta en cada lugar (tu computadora, Vercel).
# Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (Si falta, Better Auth usa AUTH_SECRET, la que existía con Auth.js.)
BETTER_AUTH_SECRET=
# Dirección principal del sitio, sin "/" al final. En tu computadora: http://localhost:3000.
# En Vercel es opcional: las direcciones de cada despliegue (.vercel.app, versiones de prueba y, después,
# centroferreteroelpico.com) se reconocen solas; esta solo se usa de respaldo.
BETTER_AUTH_URL=

# Entrar con Google: ID y secreto del cliente OAuth de Google Cloud (Credenciales → ID de cliente de OAuth 2.0).
# URI de redirección autorizada: <dirección del sitio>/api/auth/callback/google (la misma que con Auth.js).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Correos (verificar el correo, recuperar la contraseña) con Resend (Resend → API Keys; basta con permiso de envío).
# Sin la clave, en tu computadora los correos salen en la consola de `npm run dev`; en producción el registro con
# contraseña se apaga solo (solo Google). Ya está cargada en Vercel (Production y Preview).
# CORREO_REMITENTE es opcional: si falta, se usa Centro Ferretero El Pico <no-responder@centroferreteroelpico.com>.
# Debe ser de un dominio verificado en Resend (centroferreteroelpico.com lo está).
RESEND_API_KEY=
CORREO_REMITENTE=
